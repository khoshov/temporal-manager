# Temporal Cluster Endpoint
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# TLS / mTLS configuration (optional)
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_KEYFILE=secrets/key.pem
TEMPORAL_TLS_CERTFILE=secrets/cert.pem
TEMPORAL_TLS_CA_CERT=secrets/ca-chain.pem
TEMPORAL_TLS_VERIFICATION_SERVER_NAME=
TEMPORAL_TLS_DOMAIN=

# App Server Port
APP_HOST=0.0.0.0
APP_PORT=8000
